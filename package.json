{
	"main": "electron.js",
	"name": "vieapps-ngx-portals-desktop",
	"productName": "NGX Portals",
	"description": "Manage information and related services of CMS Portals",
	"version": "11.2611.1",
	"license": "Apache-2.0",
	"author": {
		"name": "VIEApps.net",
		"email": "vieapps.net@gmail.com"
	},
	"homepage": "https://cms.vieapps.net/",
	"repository": {
		"type": "git",
		"url": "git@github.com:vieapps/Apps.Portals.git"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"build": {
		"appId": "net.vieapps.apps.portals.desktop",
		"icon": "icons/ngx.png",
		"copyright": "© VIEApps.net",
		"asar": true,
		"files": [
			"icons/**/*",
			"src/**/*",
			"electron.js",
			"electron.preload.js"
		],
		"publish": [
			{
				"provider": "generic",
				"url": "https://cms.vieapps.net/releases/"
			}
		],
		"mac": {
			"category": "public.app-category.productivity",
			"target": [
				{
					"target": "dmg",
					"arch": [
						"universal"
					]
				},
				{
					"target": "zip",
					"arch": [
						"universal"
					]
				}
			]
		},
		"win": {
			"target": [
				{
					"target": "nsis",
					"arch": [
						"x64",
						"arm64"
					]
				}
			]
		},
		"linux": {
			"category": "Office",
			"target": [
				{
					"target": "AppImage",
					"arch": [
						"x64"
					]
				}
			]
		},
		"dmg": {
			"title": "${productName} ${version}",
			"window": {
				"width": 510,
				"height": 380
			},
			"backgroundColor": "#ffffff",
			"contents": [
				{
					"x": 400,
					"y": 200,
					"type": "link",
					"path": "/Applications"
				},
				{
					"x": 150,
					"y": 200
				}
			]
		},
		"nsis": {
			"oneClick": true,
			"perMachine": true
		}
	},
	"scripts": {
		"electron": "electron .",
		"electron-build": "electron-builder --mac --win --linux --publish never",
		"electron-build-mac": "electron-builder --mac --publish never",
		"electron-build-win": "electron-builder --win --publish never",
		"electron-build-linux": "electron-builder --linux --publish never"
	},
	"devDependencies": {
		"electron": "^45.2.3",
		"electron-builder": "^26.18.0"
	},
	"dependencies": {
		"compare-versions": "^6.1.1",
		"crypto-js": "^4.2.0",
		"electron-log": "^5.4.4",
		"electron-updater": "^6.8.11"
	}
}
