{
	"main": "electron.js",
	"name": "vieapps-ngx-portals-desktop",
	"productName": "NGX Portals",
	"description": "Manage information and related services of CMS Portals",
	"version": "10.2611.1",
	"license": "Apache-2.0",
	"author": {
		"name": "VIEApps.net",
		"email": "vieapps.net@gmail.com"
	},
	"homepage": "https://cms.vieapps.net/",
	"repository": {
		"type": "git",
		"url": "git@github.com:vieapps/Apps.Portals.git"
	},
	"build": {
		"appId": "net.vieapps.apps.portals.desktop",
		"directories": {
			"output": "dist"
		},
		"copyright": "© VIEApps.net",
		"asar": true,
		"files": [
			"build/**/*",
			"src/**/*",
			"electron.js"
		],
		"publish": [
			{
				"provider": "generic",
				"url": "https://cms.vieapps.net/releases/"
			}
		],
		"mac": {
			"category": "public.app-category.productivity",
			"target": [
				{
					"target": "dmg",
					"arch": [
						"universal"
					]
				},
				{
					"target": "zip",
					"arch": [
						"universal"
					]
				}
			],
			"minimumSystemVersion": "13.0.0"
		},
		"win": {
			"target": [
				{
					"target": "nsis",
					"arch": [
						"x64",
						"arm64"
					]
				}
			]
		},
		"linux": {
			"category": "Office",
			"target": [
				{
					"target": "AppImage",
					"arch": [
						"x64"
					]
				}
			]
		},
		"dmg": {
			"title": "${productName} ${version}",
			"window": {
				"width": 510,
				"height": 380
			},
			"backgroundColor": "#ffffff",
			"contents": [
				{
					"x": 400,
					"y": 200,
					"type": "link",
					"path": "/Applications"
				},
				{
					"x": 150,
					"y": 200
				}
			]
		},
		"nsis": {
			"oneClick": true,
			"perMachine": true
		}
	},
	"scripts": {
		"postinstall": "node node_modules/electron/install.js",
		"electron": "electron .",
		"electron dist": "electron .",
		"electron-build": "electron-builder --mac --win --linux --publish never",
		"electron-build-mac": "electron-builder --mac --publish never",
		"electron-build-win": "electron-builder --win --publish never",
		"electron-build-linux": "electron-builder --linux --publish never"
	},
	"devDependencies": {
		"electron": "45.2.3",
		"electron-builder": "26.18.1"
	},
	"dependencies": {
		"compare-versions": "^3.6.0",
		"crypto-js": "^4.2.0",
		"electron-log": "^4.4.6",
		"electron-updater": "6.8.12"
	},
	"engines": {
		"node": ">=22.12.0"
	}
}
